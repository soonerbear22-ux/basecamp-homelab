#!/bin/bash

# Gwaihir Homelab Operations Status
# Optional incident snapshot mode
if [ "${1:-}" = "--save" ]; then
    LOG_DIR="$HOME/gwaihir/logs"
    mkdir -p "$LOG_DIR"

    TIMESTAMP=$(date '+%Y-%m-%d_%H-%M-%S')
    LOG_FILE="$LOG_DIR/homelab-status-$TIMESTAMP.log"

    "$0" | tee "$LOG_FILE"

    echo
    echo "Snapshot saved:"
    echo "$LOG_FILE"
    exit 0
fi

# V3.3 - Network, service, Proxmox guest-state, and Elros checks

HORNBURG="${HORNBURG:-hornburg.example.invalid}"
CORE="${CORE:-core-services.example.invalid}"
PIHOLE="${PIHOLE:-pihole.example.invalid}"
SENTINEL="${SENTINEL:-sentinel.example.invalid}"
PALANTIR="${PALANTIR:-palantir.example.invalid}"
MEDIA="${MEDIA:-media.example.invalid}"
ELROS="${ELROS:-elros.example.invalid}"
SSH_KEY="${SSH_KEY:-$HOME/.ssh/gwaihir_homelab}"

host_check() {
    local name="$1"
    local ip="$2"

    if ping -c 1 -W 1 "$ip" >/dev/null 2>&1; then
        printf "%-24s ONLINE\n" "$name"
    else
        printf "%-24s UNREACHABLE\n" "$name"
    fi
}

tcp_check() {
    local name="$1"
    local host="$2"
    local port="$3"

    if timeout 2 bash -c "</dev/tcp/$host/$port" >/dev/null 2>&1; then
        printf "%-24s RESPONDING\n" "$name"
    else
        printf "%-24s UNREACHABLE\n" "$name"
    fi
}

http_check() {
    local name="$1"
    local url="$2"
    local expected="${3:-200}"

    code=$(curl -k -L -s -o /dev/null -w "%{http_code}" \
        --connect-timeout 2 --max-time 4 "$url")

    if [ "$code" = "$expected" ]; then
        printf "%-24s HEALTHY (HTTP %s)\n" "$name" "$code"
    elif [ "$code" != "000" ]; then
        printf "%-24s RESPONDING (HTTP %s)\n" "$name" "$code"
    else
        printf "%-24s UNREACHABLE\n" "$name"
    fi
}

get_proxmox_states() {
    PROXMOX_STATE=$(ssh -i "$SSH_KEY" \
        -o IdentitiesOnly=yes \
        -o BatchMode=yes \
        -o ConnectTimeout=3 \
        root@"$HORNBURG" \
        'qm list; pct list' 2>/dev/null)
}

guest_state() {
    local vmid="$1"
    local name="$2"

    state=$(printf '%s\n' "$PROXMOX_STATE" |
        awk -v id="$vmid" '$1 == id {
            if ($2 == "running" || $2 == "stopped") print $2;
            else print $3;
            exit
        }')

    case "$state" in
        running)
            printf "%-24s RUNNING\n" "$name"
            ;;
        stopped)
            printf "%-24s STOPPED\n" "$name"
            ;;
        *)
            printf "%-24s UNKNOWN\n" "$name"
            ;;
    esac
}

echo
echo "========================================"
echo "       GWAIHIR HOMELAB STATUS V3.3"
echo "========================================"
echo "Checked: $(date)"
echo

echo "===== HOST REACHABILITY ====="
host_check "Hornburg" "$HORNBURG"
host_check "core-services" "$CORE"
host_check "Pi-hole" "$PIHOLE"
host_check "Sentinel" "$SENTINEL"
host_check "Palantir" "$PALANTIR"
host_check "media-automation" "$MEDIA"

echo
echo "===== PROXMOX GUESTS ====="
get_proxmox_states
guest_state 100 "VM 100 core-services"
guest_state 101 "LXC 101 Pi-hole"
guest_state 102 "VM 102 Bombadil"
guest_state 103 "LXC 103 Palantir"
guest_state 104 "LXC 104 media-auto"
guest_state 105 "VM 105 Arda"

echo
echo "===== CORE SERVICES ====="
http_check "Grafana" "http://$CORE:3000/login"
http_check "Uptime Kuma" "http://$CORE:3001"
http_check "Open WebUI" "http://$CORE:3002"
http_check "Homepage" "http://$CORE:3003"
http_check "Qdrant" "http://$CORE:6333/collections"
tcp_check  "Open Terminal" "$CORE" 8000
tcp_check  "Beszel" "$CORE" 8090
tcp_check  "Homelab API" "$CORE" 8091
http_check "Prometheus" "http://$CORE:9090/-/healthy"

echo
echo "===== MEDIA SERVICES ====="
http_check "Jellyfin / Palantir" \
    "http://$PALANTIR:8096/System/Info/Public"
tcp_check "Radarr" "$MEDIA" 7878
tcp_check "Sonarr" "$MEDIA" 8989
tcp_check "Prowlarr" "$MEDIA" 9696
tcp_check "qBittorrent" "$MEDIA" 8080

echo
echo "===== INFRASTRUCTURE ====="
tcp_check "Proxmox Web" "$HORNBURG" 8006
http_check "Sentinel Kuma" "http://$SENTINEL:3001"

echo
echo "===== EXTERNAL SYSTEMS ====="

if timeout 2 bash -c "</dev/tcp/$ELROS/11434" >/dev/null 2>&1 || \
   timeout 2 bash -c "</dev/tcp/$ELROS/8188" >/dev/null 2>&1 || \
   timeout 2 bash -c "</dev/tcp/$ELROS/47989" >/dev/null 2>&1; then
    printf "%-24s ONLINE\n" "Elros"
else
    printf "%-24s UNREACHABLE\n" "Elros"
fi

http_check "Elros Ollama" "http://$ELROS:11434/api/tags"
http_check "Elros ComfyUI" "http://$ELROS:8188/"
tcp_check "Elros Kokoro TTS" "$ELROS" 8880
tcp_check "Elros Sunshine 47984" "$ELROS" 47984
tcp_check "Elros Sunshine 47989" "$ELROS" 47989
tcp_check "Elros Sunshine 47990" "$ELROS" 47990
tcp_check "Elros Sunshine 48010" "$ELROS" 48010

echo
echo "========================================"
