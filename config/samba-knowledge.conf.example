# Merge this share into your locally reviewed Samba configuration.
# The template uses a dedicated local basecamp account instead of a personal account.
[knowledge-inbox]
    comment = Homelab knowledge inbox
    path = /opt/basecamp/knowledge/inbox
    browseable = yes
    read only = no
    guest ok = no
    valid users = basecamp
    force user = basecamp
    force group = basecamp
    create mask = 0664
    directory mask = 0775
