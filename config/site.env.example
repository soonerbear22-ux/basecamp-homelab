# Copy to ignored site.env. These examples cannot reach a real deployment.
# Keep values on one line. Single/double quotes around whole values are supported.
CORE_BIND_ADDRESS=127.0.0.1
DATA_ROOT=/opt/basecamp/data
QDRANT_STORAGE=/opt/basecamp/compose/qdrant/storage
HOMEPAGE_ALLOWED_HOSTS=core-services.example.invalid:3003
OLLAMA_BASE_URL=http://main-pc.example.invalid:11434
WEBUI_SECRET_KEY=REPLACE_ME
OPEN_TERMINAL_API_KEY=REPLACE_ME
GRAFANA_ADMIN_PASSWORD=REPLACE_ME
BESZEL_APP_URL=http://core-services.example.invalid:8090
BESZEL_KEY=REPLACE_ME
BESZEL_TOKEN=REPLACE_ME
# Node Exporter is in host networking. Choose a private interface reachable by Prometheus.
NODE_EXPORTER_LISTEN=REPLACE_ME:9100
CORE_NODE_EXPORTER_TARGET=core-services.example.invalid:9100
BASECAMP_NODE_EXPORTER_TARGET=basecamp.example.invalid:9100
PVE_URL=https://basecamp.example.invalid:8006
PVE_TOKEN_ID=REPLACE_ME
PVE_TOKEN=REPLACE_ME
# Put the trusted Proxmox CA in this directory as ca.crt (never a private key).
PVE_CA_DIRECTORY=/opt/basecamp/private/pve-ca
EMBEDDING_URL=http://ai-worker.example.invalid:8080/embed
AI_WORKER_LAN_HOST=ai-worker.example.invalid
AI_WORKER_OVERLAY_HOST=ai-worker-overlay.example.invalid
AI_WORKER_EMBEDDING_URL=http://ai-worker.example.invalid:8080
# Worker settings: change loopback to the intended private interface before remote use.
AI_WORKER_BIND_ADDRESS=127.0.0.1
EMBEDDING_MODEL_CACHE=/opt/basecamp/compose/ai-worker/embeddings/models
# Host-side ingestion uses the loopback-published Qdrant port.
KNOWLEDGE_BASE=/opt/basecamp/knowledge
QDRANT_URL=http://localhost:6333
# Read-only validation endpoints (local values only).
HOMELAB_API_URL=http://localhost:8091
